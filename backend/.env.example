# 复制为 backend/.env.local 后填写。该文件包含凭据，绝不要提交。

# 可选：单题“AI 临时试算”。留空时按钮会提示未配置，不影响题库学习。
GRADE_BASE_URL=
GRADE_API_KEY=
GRADE_MODEL=gpt-5.6-luna

# 仅在运行 MinerU 导入脚本时需要。
MINERU_TOKEN=

# 对外经 Cloudflare Tunnel 访问时的浏览器 Basic Auth。
# 留空时 start-dev.sh 会在 backend/.access-password 自动生成随机密码。
STUDY_ACCESS_USER=study
STUDY_ACCESS_PASSWORD=

# 防止 AI 临时试算意外消耗额度；单位为每小时调用数。
STUDY_AI_MAX_PER_HOUR=12
